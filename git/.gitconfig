[user]
	name = FrankCallahan-MC
	email = Francis.callahan@emsmc.com
[maintenance]
	auto = true
[feature]
	manyFiles = true
[core]
	pager = delta
[gc]
	writeCommitGraph = true
[delta]
	dark = true
	side-by-side = true
	line-numbers = true
	hyperlinks = true
[push]
	autoSetupRemote = true
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://github.com/Fcallahan"]
	# personal repos always use the Fcallahan token, whichever gh account is active
	helper = 
	helper = "!f() { test \"$1\" = get && echo username=Fcallahan && echo \"password=$(gh auth token -u Fcallahan)\"; }; f"
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[pull]
	rebase = true
[alias]
	clone-wt = !clone-wt
